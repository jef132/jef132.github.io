---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- ==================== NAV ==================== -->
  <header id="top">
    <nav class="nav" id="navbar">
      <div class="nav-inner">
        <a href="#top" class="nav-logo">Jef Aldrich</a>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav-links" id="navLinks">
          <li><a href="#about">About</a></li>
          <li><a href="#stats">By the Numbers</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#writing">Writing</a></li>
          <li><a href="#certifications">Credentials</a></li>
          <li>
            <a href="#connect" class="nav-cta">Connect</a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <!-- ==================== HERO ==================== -->
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-text">
        <p class="hero-eyebrow">Atlanta, GA</p>
        <h1 class="hero-name">Jef Aldrich</h1>
        <p class="hero-tagline">
          Global IT Leader&nbsp;&middot; Artificial Intelligence (AI) &amp; Cybersecurity Strategist<br />
          Turning Emerging Technology into Enterprise Outcomes
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">View My Work</a>
          <a
            href="https://www.linkedin.com/in/jefa"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-white"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            Connect on LinkedIn
          </a>
        </div>
      </div>
      <div class="hero-image-wrap">
        <div class="hero-image-frame">
          <img
            src="/Headshot.jpg"
            alt="Jef Aldrich — Global IT Leader"
            class="hero-image"
            width="420"
            height="420"
          />
        </div>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="about-section" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-left reveal">
          <p class="section-label">About Me</p>
          <h2 class="section-title">Building at the Intersection of Leadership &amp; Technology</h2>
          <div class="about-accent"></div>
        </div>
        <div class="about-right reveal reveal-delay-2">
          <p class="about-bio">
            With over 15 years at Intercontinental Exchange (ICE), I lead a 30+ person global IT team
            spanning the US, Europe, India, and Japan. My work sits at the intersection of enterprise
            leadership and hands-on technical development — from architecting Zero Trust security
            transformations and cloud identity modernization to building AI-powered automation tools
            in Python.
          </p>
          <p class="about-bio">
            I've led 20+ M&amp;A integrations, managed multi-million dollar budgets, and earned
            certifications including CISSP, CISM, and OSCP. In 2026 I completed a Post Graduate Program
            in AI &amp; Machine Learning at UT Austin McCombs School of Business, where I built real tools
            using Python, LangChain, RAG pipelines, LLMs, and computer vision — because I believe the best
            IT leaders don't just oversee technology, they build it.
          </p>
          <div class="about-tags">
            <span class="tag">Zero Trust</span>
            <span class="tag">Cloud Identity</span>
            <span class="tag">AI / LLMs</span>
            <span class="tag">M&amp;A Integration</span>
            <span class="tag">Python</span>
            <span class="tag">LangChain</span>
            <span class="tag">Cybersecurity</span>
            <span class="tag">Enterprise Leadership</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== STATS ==================== -->
  <section class="stats-section" id="stats">
    <div class="container">
      <div class="stats-header reveal">
        <p class="section-label" style="color: rgba(255,255,255,0.6);">By the Numbers</p>
        <h2 class="section-title" style="color: var(--white);">A Decade and a Half of Impact</h2>
      </div>
      <div class="stats-grid">
        <div class="stat-card reveal reveal-delay-1">
          <span class="stat-number">15<span class="stat-plus">+</span></span>
          <span class="stat-label">Years at ICE</span>
        </div>
        <div class="stat-card reveal reveal-delay-2">
          <span class="stat-number">30<span class="stat-plus">+</span></span>
          <span class="stat-label">Person Global Team</span>
        </div>
        <div class="stat-card reveal reveal-delay-3">
          <span class="stat-number">20<span class="stat-plus">+</span></span>
          <span class="stat-label">M&amp;A Integrations Led</span>
        </div>
        <div class="stat-card reveal reveal-delay-4">
          <span class="stat-number">4</span>
          <span class="stat-label">Continents of Operations</span>
        </div>
        <div class="stat-card reveal reveal-delay-5">
          <span class="stat-number">3</span>
          <span class="stat-label">Security Certifications<span class="stat-certs">CISSP · CISM · OSCP</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PROJECTS ==================== -->
  <section class="projects-section" id="projects">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Projects</p>
        <h2 class="section-title">Built, Not Just Managed</h2>
        <p class="section-subtitle">
          A selection of tools I've engineered — from enterprise security GUIs to IoT infrastructure.
        </p>
      </div>
      <div class="projects-grid">
        <a
          href="https://github.com/jef132/CyberArkAppLauncherGUI-PowerShell"
          target="_blank"
          rel="noopener noreferrer"
          class="project-card reveal reveal-delay-1"
        >
          <div class="project-card-top">
            <div class="project-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
              </svg>
            </div>
            <span class="project-lang lang-ps">PowerShell</span>
          </div>
          <h3 class="project-title">CyberArkAppLauncherGUI</h3>
          <p class="project-desc">
            A PowerShell-based GUI for launching CyberArk applications, streamlining privileged
            access workflows for enterprise environments.
          </p>
          <span class="project-link">
            View on GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>

        <a
          href="https://github.com/jef132/CyberArkAppLauncherGUI-CSharp"
          target="_blank"
          rel="noopener noreferrer"
          class="project-card reveal reveal-delay-2"
        >
          <div class="project-card-top">
            <div class="project-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
              </svg>
            </div>
            <span class="project-lang lang-cs">C#</span>
          </div>
          <h3 class="project-title">CyberArkAppLauncherGUI <span style="opacity:0.5; font-weight:500;">C#</span></h3>
          <p class="project-desc">
            A C# implementation of the CyberArk Application Launcher GUI, built for performance
            and enterprise deployment.
          </p>
          <span class="project-link">
            View on GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>

        <a
          href="https://github.com/jef132/Arduino-MKRWifi1010-PIR-MQTT"
          target="_blank"
          rel="noopener noreferrer"
          class="project-card reveal reveal-delay-3"
        >
          <div class="project-card-top">
            <div class="project-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
              </svg>
            </div>
            <span class="project-lang lang-iot">IoT / Arduino</span>
          </div>
          <h3 class="project-title">Arduino MKRWifi1010 PIR MQTT</h3>
          <p class="project-desc">
            IoT motion detection using Arduino MKR WiFi 1010 with a PIR sensor publishing events
            over MQTT — an early exploration of connected infrastructure.
          </p>
          <span class="project-link">
            View on GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>
      </div>
      <div class="projects-cta reveal">
        <a
          href="https://github.com/jef132"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
          View All on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== WRITING ==================== -->
  <section class="writing-section" id="writing">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Writing &amp; Insights</p>
        <h2 class="section-title">Thinking Out Loud</h2>
        <p class="section-subtitle">
          Perspectives on leadership, technology, and the journey of building at the enterprise edge.
        </p>
      </div>
      <div class="writing-grid">
        <a
          href="https://www.linkedin.com/feed/update/urn:li:activity:7446904817656049664/"
          target="_blank"
          rel="noopener noreferrer"
          class="article-card reveal reveal-delay-1"
        >
          <div class="article-meta">
            <span class="article-source">LinkedIn</span>
          </div>
          <h3 class="article-title">From High School Intern to Global IT Leader</h3>
          <p class="article-desc">
            Reflecting on the IT internship that started it all — and the career that grew from it.
          </p>
          <span class="article-link">
            Read on LinkedIn
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>

        <a
          href="https://www.linkedin.com/feed/update/urn:li:activity:7449441268792913921/"
          target="_blank"
          rel="noopener noreferrer"
          class="article-card reveal reveal-delay-2"
        >
          <div class="article-meta">
            <span class="article-source">LinkedIn</span>
          </div>
          <h3 class="article-title">Completing My Post Graduate AI &amp; ML Program</h3>
          <p class="article-desc">
            What I learned building real AI tools in Python, LangChain, and LLMs as a practicing IT executive.
          </p>
          <span class="article-link">
            Read on LinkedIn
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CERTIFICATIONS ==================== -->
  <section class="certs-section" id="certifications">
    <div class="container">
      <div class="reveal">
        <p class="section-label">Credentials</p>
        <h2 class="section-title">Certifications &amp; Education</h2>
        <p class="section-subtitle">
          Validated expertise across security, leadership, and applied machine learning.
        </p>
      </div>
      <div class="certs-grid">
        <div class="cert-card reveal reveal-delay-1">
          <div class="cert-badge cert-security">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="cert-info">
            <h3 class="cert-title">CISSP</h3>
            <p class="cert-sub">Certified Information Systems Security Professional</p>
          </div>
        </div>

        <div class="cert-card reveal reveal-delay-2">
          <div class="cert-badge cert-security">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="cert-info">
            <h3 class="cert-title">CISM</h3>
            <p class="cert-sub">Certified Information Security Manager</p>
          </div>
        </div>

        <div class="cert-card reveal reveal-delay-3">
          <div class="cert-badge cert-offensive">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
          </div>
          <div class="cert-info">
            <h3 class="cert-title">OSCP</h3>
            <p class="cert-sub">Offensive Security Certified Professional</p>
          </div>
        </div>

        <div class="cert-card reveal reveal-delay-1">
          <div class="cert-badge cert-edu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div class="cert-info">
            <h3 class="cert-title">MBA</h3>
            <p class="cert-sub">Kennesaw State University &middot; 2008</p>
          </div>
        </div>

        <div class="cert-card cert-card-wide reveal reveal-delay-2">
          <div class="cert-badge cert-ai">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z"/>
            </svg>
          </div>
          <div class="cert-info">
            <h3 class="cert-title">Post Graduate Program — AI &amp; Machine Learning: Business Applications</h3>
            <p class="cert-sub">UT Austin McCombs School of Business &middot; 2026</p>
          </div>
        </div>
      </div>

      <div class="certs-credly reveal">
        <a
          href="https://www.youracclaim.com/users/jef-aldrich/badges"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/>
          </svg>
          View Credly Badges
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== CONNECT ==================== -->
  <section class="connect-section" id="connect">
    <div class="container">
      <div class="connect-inner reveal">
        <p class="section-label" style="color: rgba(255,255,255,0.6);">Get in Touch</p>
        <h2 class="connect-title">Let's Connect</h2>
        <p class="connect-sub">
          Whether you're exploring collaboration, looking for a strategic IT perspective, or just want to talk about AI and cybersecurity — I'd love to hear from you.
        </p>
        <div class="connect-actions">
          <a
            href="https://www.linkedin.com/in/jefa"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            Connect on LinkedIn
          </a>
          <a
            href="https://github.com/jef132"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-white"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            View GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FOOTER ==================== -->
  <footer class="footer">
    <div class="container">
      <div class="footer-inner">
        <p class="footer-copy">&copy; {new Date().getFullYear()} Jef Aldrich. All rights reserved.</p>
        <div class="footer-links">
          <a href="https://www.linkedin.com/in/jefa" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://github.com/jef132" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ===== NAV ===== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

